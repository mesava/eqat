{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquipmentProfile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "features"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "scope": {
      "enum": ["linac", "ct"],
      "default": "linac"
    },
    "photon_energies": {"type": "array", "items": {"type": "string"}},
    "electron_energies_MeV": {"type": "array", "items": {"type": "number"}},
    "features": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "present",
          "absent",
          "unknown"
        ]
      }
    },
    "machine_config_validated": {
      "type": "boolean"
    }
  }
}
